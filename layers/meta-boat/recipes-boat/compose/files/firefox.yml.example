# Example - copy to /data/compose/ and adjust before use.
# Confirmed working on real arm64 hardware (see docs/05-phase2-boat-computer-layer.md
# "Example: Firefox as the helm UI") - linuxserver/firefox has official arm64v8
# builds and doesn't touch the host's display at all: it runs its own
# browser-accessible desktop (KasmVNC), so you view it from ANY device's
# browser on the network, not just the boat's own HDMI screen.
#
# Use x11-app.yml.example instead if you want a GUI app rendering directly on
# the Jetson's HDMI screen alongside the XFCE desktop.
services:
  firefox:
    image: lscr.io/linuxserver/firefox:latest
    container_name: firefox
    security_opt:
      - seccomp=unconfined   # optional, quiets some sandbox syscall warnings
    environment:
      # The uid/gid linuxserver's init chowns /config to, and therefore the
      # owner of the browser profile on the host. 2000:2000 is the "boat"
      # user (boat-image.bb's useradd -u 2000), so the profile stays
      # manageable and backup-able from the desktop session without sudo.
      # Deliberately NOT the linuxserver default of 1000:1000: no account on
      # this image has uid 1000, so those files would show up as a bare
      # numeric owner - see docs/05 "Container file ownership".
      - PUID=2000
      - PGID=2000
      - TZ=Etc/UTC
    volumes:
      - /data/firefox/config:/config   # persistent browser profile on NVMe
    ports:
      - 3000:3000   # http://<jetson-ip>:3000 - KasmVNC, any browser, any device on the LAN
    shm_size: "1gb"
    restart: unless-stopped
