[Unit]
Description=Bring up the boat's docker-compose stack from /data/compose
Documentation=file:///usr/share/boat/compose-examples/README
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
# The compose files live on /data (see boat-compose-up). RequiresMountsFor
# resolves to whatever unit actually provides the closest mount point, so it is
# correct both today, when /data is a directory on the rootfs and this pulls in
# the always-active -.mount, and later when /data becomes its own partition -
# without the unit having to name a data.mount that may not exist. An
# "After=data.mount" naming a non-existent unit, which is what this used to
# say, is silently no ordering at all.
RequiresMountsFor=/data/compose

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/boat-compose-up
# Without this, `systemctl stop boat-compose` marks the unit inactive and
# leaves every container running - and the next `start` is then a no-op against
# a stack nobody is tracking. `compose down` is also what makes a clean
# shutdown stop containers rather than have dockerd kill them.
ExecStop=/usr/bin/boat-compose-up --down

[Install]
WantedBy=multi-user.target
