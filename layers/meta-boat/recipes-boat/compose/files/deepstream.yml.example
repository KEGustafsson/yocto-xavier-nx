# Example - copy to /data/compose/ and adjust before use.
# See docs/05-phase2-boat-computer-layer.md "Deploying an app: DeepStream".
#
# OPEN RISK: validate `docker run --runtime nvidia ...` sees the GPU on this
# machine/L4T combo before relying on this - nvidia-container-toolkit on
# meta-tegra kirkstone is unproven (docs/05 "Open risks").
#
# CHECK THE IMAGE TAG AGAINST NGC BEFORE USING IT. NVIDIA retired the separate
# "deepstream-l4t" repository after 6.2 in favour of multi-arch tags on
# nvcr.io/nvidia/deepstream, and the DeepStream release has to match the L4T
# the host runs: this project builds R35.6.4 / JetPack 5.1.6, while the 6.3
# images were cut against JetPack 5.1.2 (R35.4.1). Browse
# https://catalog.ngc.nvidia.com/ for the tag that matches your build rather
# than trusting the one written here - and pin it by digest once you have one
# that works.
services:
  vision-ai:
    image: nvcr.io/nvidia/deepstream:6.3-samples-multiarch
    runtime: nvidia                # or rely on Docker's default-runtime
    network_mode: host
    volumes:
      - /tmp/argus_socket:/tmp/argus_socket             # CSI camera (Argus)
      - /data/models:/models
    # A USB camera, if there is one. Left commented out deliberately: a
    # `devices:` entry is not conditional, so naming /dev/video0 on a board
    # with no USB camera makes `docker compose up` fail outright rather than
    # start without it. CSI cameras come in over the Argus socket above, not
    # through here.
    # devices:
    #   - /dev/video0
    restart: unless-stopped
