# Phase 1 stub: commits every boot that gets this far, with no health gate.
# Phase 4 replaces it with boat-commit (docs/plans/ab-os-updates.md 5.4).
[Unit]
Description=Confirm the booted A/B slot came up (no health gate yet)
ConditionKernelCommandLine=rauc.slot
# Bench switch: a slot whose rootfs has /etc/boat-ab-nocommit is never
# confirmed - e.g. to test that a crashing trial falls back. (The kernel
# command line cannot be edited on this board: GRUB has no menu.) Create it
# in the test slot from the running one, before rebooting into it.
ConditionPathExists=!/etc/boat-ab-nocommit
Requires=boat-grubenv-guard.service
After=boat-grubenv-guard.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/boat-ab-commit

[Install]
WantedBy=multi-user.target
