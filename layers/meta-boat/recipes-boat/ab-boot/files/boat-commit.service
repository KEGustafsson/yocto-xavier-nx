# The A/B health gate (docs/plans/ab-os-updates.md 5.4). DefaultDependencies
# =no on purpose: multi-user.target is then NOT ordered after it, so a gate
# that waits for multi-user's units cannot deadlock the boot it is judging.
[Unit]
Description=A/B health gate: commit, or fail, the slot this boot came from
Documentation=https://github.com/KEGustafsson/yocto-xavier-nx/blob/main/docs/plans/ab-os-updates.md
DefaultDependencies=no
ConditionKernelCommandLine=rauc.slot
# Wants, not Requires: a guard that failed (an ESP that will not mount or
# take writes) must not stop the gate - its Tier 1 then names the problem.
Wants=boat-grubenv-guard.service
# Not after docker.service or data.mount: Docker waits for /data, and /data
# for its own check, which may take long. The script waits for DATA itself,
# within its deadline, so a /data problem can never hold up - or fail - the
# OS's own verdict.
After=boat-grubenv-guard.service basic.target network.target NetworkManager.service systemd-logind.service dbus.service sshd.socket boat-bootmode-guard.service
Conflicts=shutdown.target
Before=shutdown.target
# Not in emergency or rescue mode. Without default dependencies the gate is
# not stopped with sysinit.target when local-fs fails into emergency mode,
# and on a committed slot its first act - resetting the attempt count -
# would undo the very count that lets GRUB fall back from a slot that keeps
# ending there (boat-emergency-reboot reboots it every 60 s).
Conflicts=emergency.service emergency.target rescue.service rescue.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/boat-commit
# The checks retry for BOAT_HEALTH_DEADLINE (9 minutes); this is the hard
# stop if something in them hangs.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
