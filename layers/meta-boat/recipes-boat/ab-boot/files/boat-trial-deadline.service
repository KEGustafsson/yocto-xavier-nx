[Unit]
Description=Fail an A/B trial that has not committed in time
Documentation=https://github.com/KEGustafsson/yocto-xavier-nx/blob/main/docs/plans/ab-os-updates.md
ConditionKernelCommandLine=boat.trial=1

[Service]
Type=oneshot
ExecStart=/usr/sbin/boat-commit --deadline
# The backstop's backstop: if the deadline run itself ends in an error
# rather than a verdict, reboot anyway - GRUB's attempt count then ends the
# trial. Not under boat.stay=1, which keeps a failed trial up on purpose.
ExecStopPost=/bin/sh -c '[ "$$SERVICE_RESULT" = success ] || grep -qw boat.stay=1 /proc/cmdline || systemctl reboot'
