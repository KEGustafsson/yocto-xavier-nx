# A/B rootfs slot selection for the boat computer.
#
# Generated by meta-boat's boat-grub-esp at build time and written to the ESP
# by a flash. Do not edit it on the board: the ESP is not A/B, and this file
# only changes with a USB reflash. The state machine it runs is described in
# docs/plans/ab-os-updates.md section 5.3.
#
# State lives in grubenv next to this file:
#   ORDER        slots in the order to try them, e.g. "B A"
#   x_OK         1 = slot x is usable (RAUC clears it before writing a slot)
#   x_TRY        boot attempts since slot x was last confirmed good
#   x_COMMITTED  1 = slot x has passed a trial boot; 0 = it is on trial
#   BOAT_STAY    1 = bench debugging: no automatic reboots (boat.stay=1)
#
# A slot on trial gets ONE attempt; a committed slot gets TWO, so a single
# power cut during boot never moves the boat back to an older OS. Both stay
# inside the 3 warm boots NVIDIA's own rootfs counter allows before it marks
# the drive unbootable. A slot on trial is never booted unless its attempt
# was written to grubenv first.
#
# There is no menu and no prompt: every path below ends in `boot` or
# `reboot`. A GRUB that stopped at a prompt would sit there forever, and a
# fallback to the other slot only ever happens on the NEXT boot.

set timeout=0
set pager=0
# A superuser that has no password: nobody can authenticate, so the console
# can neither edit a kernel command line nor open GRUB's shell.
set superusers="boat-locked"

# The slots live on the drive GRUB itself was loaded from (the NVMe ESP), and
# are addressed by GPT entry number - never by a label that a JetPack SD card
# or a USB stick could also carry.
regexp --set=1:bootdisk '^([^,]+),' "$root"
if [ -z "$bootdisk" ]; then
    echo "boat: cannot tell which disk GRUB was loaded from (root=$root) - resetting"
    sleep 10
    reboot
fi

# Platform kernel arguments, written by L4TLauncher before it starts GRUB.
set cbootargs=""
if [ -f "$prefix/boot.cfg" ]; then
    source "$prefix/boot.cfg"
fi

# Defaults, used only if grubenv cannot be read: boot the flashed slot.
set ORDER="A B"
set A_OK=1
set A_TRY=0
set A_COMMITTED=1
set B_OK=0
set B_TRY=0
set B_COMMITTED=0
set BOAT_STAY=0
set envok=1
if load_env -f "$prefix/grubenv" ORDER A_OK A_TRY A_COMMITTED B_OK B_TRY B_COMMITTED BOAT_STAY; then
    set envok=1
else
    # grubenv is torn or missing. GRUB can only rewrite a valid env block,
    # so nothing is saved this boot; boat-grubenv-guard rebuilds the file
    # once Linux is up.
    set envok=0
    echo "boat: grubenv unreadable - using grubenv.bak or the defaults"
    load_env -f "$prefix/grubenv.bak" ORDER A_OK A_TRY A_COMMITTED B_OK B_TRY B_COMMITTED BOAT_STAY
fi

# Anything but a known count is treated as "attempts used up".
if [ "$A_TRY" != 0 -a "$A_TRY" != 1 ]; then set A_TRY=2; fi
if [ "$B_TRY" != 0 -a "$B_TRY" != 1 ]; then set B_TRY=2; fi

# Pick the first usable slot in ORDER, passing over $skip. A slot on trial
# gets its one attempt only if that attempt can be recorded ($envok): an
# attempt that is never counted could repeat forever.
function pick_slot {
    set chosen=""
    for SLOT in $ORDER; do
        if [ "$SLOT" = "$skip" ]; then continue; fi
        if [ "$SLOT" = A ]; then
            if [ "$A_OK" != 1 ]; then continue; fi
            if [ "$A_COMMITTED" = 1 ]; then set limit=2; else set limit=1; fi
            if [ "$A_TRY" -ge "$limit" ]; then
                echo "boat: slot A used its $limit attempt(s) without being confirmed - marking it bad"
                set A_OK=0
                if [ "$envok" = 1 ]; then save_env -f "$prefix/grubenv" A_OK; fi
                continue
            fi
            if [ "$A_COMMITTED" != 1 -a "$envok" != 1 ]; then
                echo "boat: slot A is on trial, but its attempt cannot be recorded - passing over it"
                continue
            fi
            if [ "$A_TRY" = 0 ]; then set A_TRY=1; else set A_TRY=2; fi
            set chosen=A
            set committed="$A_COMMITTED"
            break
        elif [ "$SLOT" = B ]; then
            if [ "$B_OK" != 1 ]; then continue; fi
            if [ "$B_COMMITTED" = 1 ]; then set limit=2; else set limit=1; fi
            if [ "$B_TRY" -ge "$limit" ]; then
                echo "boat: slot B used its $limit attempt(s) without being confirmed - marking it bad"
                set B_OK=0
                if [ "$envok" = 1 ]; then save_env -f "$prefix/grubenv" B_OK; fi
                continue
            fi
            if [ "$B_COMMITTED" != 1 -a "$envok" != 1 ]; then
                echo "boat: slot B is on trial, but its attempt cannot be recorded - passing over it"
                continue
            fi
            if [ "$B_TRY" = 0 ]; then set B_TRY=1; else set B_TRY=2; fi
            set chosen=B
            set committed="$B_COMMITTED"
            break
        fi
    done
}

set skip=""
pick_slot
# The attempt is counted BEFORE the kernel is loaded, so a power cut or a
# hang from here on still counts against this slot.
if [ -n "$chosen" -a "$envok" = 1 ]; then
    if save_env -f "$prefix/grubenv" A_TRY B_TRY; then
        true
    elif [ "$committed" != 1 ]; then
        # The ESP will not take writes. Treat it like an unreadable grubenv
        # from here on: no more writes, and no slot on trial.
        echo "boat: could not record the attempt on trial slot $chosen - choosing again"
        set envok=0
        set skip="$chosen"
        pick_slot
    fi
fi

# Load and boot slot $chosen. Returns only if its kernel or initrd did not
# load, or did not start.
function boot_chosen {
    if [ "$chosen" = A ]; then set partnum=@PARTNUM_A@; else set partnum=@PARTNUM_B@; fi
    set args="$extra"
    if [ "$committed" != 1 ]; then set args="$args boat.trial=1"; fi
    if [ "$BOAT_STAY" = 1 ]; then set args="$args boat.stay=1"; fi
    echo "boat: booting slot $chosen (${bootdisk},gpt${partnum}) $args"
    linux (${bootdisk},gpt${partnum})/boot/Image $cbootargs @KERNEL_ARGS@ root=@DISK@p${partnum} rootwait rw rootfstype=ext4 rauc.slot=$chosen panic=10 $args
    if [ "$?" = 0 ]; then
        initrd (${bootdisk},gpt${partnum})/boot/initrd
        if [ "$?" = 0 ]; then
            boot
        fi
    fi
}

set extra=""
if [ -z "$chosen" ]; then
    # Nothing qualifies. Booting something uncounted beats stopping on a boat
    # with nobody at the console. A slot that passed a trial (COMMITTED=1)
    # and only ran out of attempts comes first, in ORDER: the slot that had
    # failed or was half way through an install never is. Then any other
    # slot, the flashed A first. Nothing is written: if none of them boots,
    # NVIDIA's own counter ends this in its recovery state after 3 warm
    # boots. boat-commit raises an alert on such a boot (boat.lastresort=1).
    set candidates=""
    set seenA=0
    set seenB=0
    for SLOT in $ORDER; do
        if [ "$SLOT" = A -a "$seenA" = 0 -a "$A_COMMITTED" = 1 ]; then set candidates="$candidates A"; set seenA=1; fi
        if [ "$SLOT" = B -a "$seenB" = 0 -a "$B_COMMITTED" = 1 ]; then set candidates="$candidates B"; set seenB=1; fi
    done
    if [ "$seenA" = 0 ]; then set candidates="$candidates A"; fi
    if [ "$seenB" = 0 ]; then set candidates="$candidates B"; fi
    echo "boat: no slot is usable - last resort, uncounted, in this order:$candidates"
    set extra="boat.lastresort=1"
    set committed=1
    for SLOT in $candidates; do
        set chosen="$SLOT"
        boot_chosen
        echo "boat: last resort: slot $SLOT failed to load"
    done
    echo "boat: no slot could be loaded - resetting"
    sleep 5
    reboot
fi

boot_chosen

# The kernel or initrd of the chosen slot did not load, or did not start.
echo "boat: slot $chosen failed to load - marking it bad and resetting"
if [ "$chosen" = A ]; then set A_OK=0; else set B_OK=0; fi
if [ "$envok" = 1 ]; then save_env -f "$prefix/grubenv" A_OK B_OK; fi
sleep 5
reboot
