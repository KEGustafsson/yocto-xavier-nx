# Reference fragment for a manual build (scripts/02-configure-build.sh writes
# this automatically). Append the relevant lines to your build/conf/local.conf.

MACHINE = "jetson-xavier-nx-devkit"

# NVIDIA BSP/firmware components are shipped under commercial/proprietary flags.
LICENSE_FLAGS_ACCEPTED += "commercial"

# systemd init - suitable for an always-on embedded computer.
INIT_MANAGER = "systemd"

# ---- Required by boat-image (Phase 2) ----
# virtualization -> Docker + nvidia-container-toolkit
# x11 + opengl   -> the Xorg / XFCE helm desktop (packagegroup-boat-hmi)
# pam            -> the systemd-logind session the autologin desktop needs
# polkit         -> what lets the desktop user reboot/shut down/suspend at all.
#                   logind authorizes those through polkit and poky gates that
#                   on this exact distro feature, so without it XFCE's Log Out
#                   dialog has Shut Down / Restart / Suspend greyed out.
# Must be set globally like this, not in the image recipe: DISTRO_FEATURES is
# evaluated per-recipe at parse time. Not needed for a Phase-1
# core-image-base build.
DISTRO_FEATURES:append = " virtualization opengl pam x11 polkit"

# ---- Newer-host accommodations (see docs/02 "Newer hosts") ----
# kirkstone's tested-distro list stops at ubuntu-24.04; sanity.bbclass splits
# this on the literal two-character sequence \n. Append your release rather
# than blanking the variable, so a genuinely untested host still warns.
SANITY_TESTED_DISTROS:append = " \n ubuntu-26.04 \n"
# kirkstone pins uninative 4.7 (glibc 2.41). When the host glibc is newer,
# bitbake disables uninative (and warns) rather than risk corrupting sstate;
# 5.2 ships glibc 2.44. Bumping relocates native/cross sstate
# (NATIVELSBSTRING becomes "universal-<gccver>"), so expect one cross-toolchain
# rebuild after changing it.
# ":forcevariable" is required: local.conf is parsed before the distro config
# that sets these with a plain "=", so an ordinary assignment here loses.
UNINATIVE_VERSION:forcevariable = "5.2"
UNINATIVE_MAXGLIBCVERSION:forcevariable = "2.44"
UNINATIVE_CHECKSUM[x86_64] = "1a2749c1379fd9f60ea3c82f1bf4844924d5a99117b74a70c57036e94e2379d4"
UNINATIVE_CHECKSUM[aarch64] = "8cf46c7ba75ebb1863fd6b74cf7d7ab910a3e99de4f01b1e9490babf8e6b9e05"

# ---- Boot rootfs from external NVMe storage ----
# Set the boot device to the first NVMe SSD's first partition.
# meta-tegra then selects an external partition layout and generates the
# initrd-flash / doexternal.sh helpers in the tegraflash tarball.
TNSPEC_BOOTDEV = "nvme0n1p1"

# Size (bytes) of the rootfs (APP) partition created on the SSD. 16 GiB shown.
# Kept small on purpose: the flasher writes this whole size over USB 2.0
# non-sparse, so it dominates flash time. Run `boat-grow-rootfs --grow` on the
# booted board to extend it over the rest of the drive.
ROOTFSPART_SIZE = "17179869184"

# Total capacity of the external (NVMe) device, in 512-byte sectors - NOT just
# the rootfs partition. It has to leave room for the kernel/boot, recovery,
# esp and UDA partitions that share the drive, or tegraparser_v2 cannot place
# APP at all and initrd-flash dies with
#   "End sector for APP, expected at: <N>, actual: 0"
# 1 GiB of headroom over ROOTFSPART_SIZE is comfortably more than they need;
# the value does not have to match the SSD's real capacity, only be >= what is
# actually used.
#
# Derived from ROOTFSPART_SIZE rather than hardcoded: raising the rootfs size
# and forgetting this line would declare a capacity smaller than APP, and that
# only fails at flash time - after the build.
TEGRA_EXTERNAL_DEVICE_SECTORS = "${@(int(d.getVar('ROOTFSPART_SIZE')) + 1073741824) // 512}"

# jetson-xavier-nx-devkit's default internal layout
# (flash_l4t_t194_spi_sd_p3668.xml) still carries an internal APP partition
# sized from ROOTFSPART_SIZE even though TNSPEC_BOOTDEV redirects the rootfs to
# NVMe - and tegraparser_v2 then rejects the generated flash.xml.bin with the
# same "End sector for APP" error. Switch the INTERNAL template to the
# QSPI-only variant, which has no APP partition; meta-tegra already wires up
# the correct external/NVMe template by itself.
PARTITION_LAYOUT_TEMPLATE_DEFAULT = "flash_l4t_t194_qspi_p3668.xml"

# ---- Optional but recommended ----
# Keep downloads and shared state outside the build dir.
# DL_DIR = "${TOPDIR}/../downloads"
# SSTATE_DIR = "${TOPDIR}/../sstate-cache"
